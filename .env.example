# ============================================================
# HUSTLE CLUB — ENVIRONMENT
#
#   cp .env.example .env      then fill in ONE provider below.
#
# .env is git-ignored and docker-ignored. Never commit it.
# After any change:  npm run check    (proves the key works)
# Full guide:        CREDENTIALS.md
# ============================================================


# ─── 1. WHICH SERVICE TO USE ─────────────────────────────────
# THIS ONE LINE decides which AI service the app talks to.
# Change it, restart, done. Keys for the others can stay in place.
#
#   mistral | anthropic | openai | groq | openrouter | ollama | custom

LLM_PROVIDER=mistral

# Leave it blank and the server auto-detects: whichever provider below
# has a key wins, preferring Mistral. Fine for a first run, but set it
# explicitly in production — otherwise adding a second key silently
# changes which service (and which bill) you are using.


# ─── 2. YOUR API KEYS ────────────────────────────────────────
# You can safely fill in MORE THAN ONE. Only the provider named in
# LLM_PROVIDER above is actually used; the rest sit idle costing
# nothing. That is the intended setup — it lets you switch services by
# editing one line, with no key hunting.

# Mistral — https://console.mistral.ai/api-keys
MISTRAL_API_KEY=

# Anthropic / Claude — https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# OpenAI — https://platform.openai.com/api-keys
# OPENAI_API_KEY=

# Groq — https://console.groq.com/keys
# GROQ_API_KEY=

# OpenRouter (one key, hundreds of models) — https://openrouter.ai/keys
# OPENROUTER_API_KEY=

# Ollama runs locally and needs no key at all — just LLM_PROVIDER=ollama.


# ─── 2b. MORE SECURE: KEEP THE KEY OUT OF THIS FILE ──────────
# Any provider above also accepts a *_API_KEY_FILE pointing at a file
# that contains nothing but the key. That file can live outside the
# repo entirely, be a Docker/Kubernetes secret, or sit on the VPS with
# chmod 600 — and it is re-read on every request, so **editing it
# rotates the key with no restart and no redeploy.**
#
# MISTRAL_API_KEY_FILE=/run/secrets/mistral_api_key
# MISTRAL_API_KEY_FILE=/etc/hustleclub/mistral.key
#
# A _FILE entry always wins over the plain key above it.
# See CREDENTIALS.md → "Option B" for the docker compose wiring.


# ─── 3. WHICH MODEL ──────────────────────────────────────────
# Give each provider its OWN model line, like the keys above. Then
# switching LLM_PROVIDER picks up the right model automatically.
#
# Leave a line blank/commented to use that provider's default.
# `npm run check` lists every model YOUR key can actually reach, and
# the boot banner prints which setting the live model came from.

# Mistral — mistral-large-latest   sharpest, priciest
#           mistral-medium-latest  balanced (the default)
#           mistral-small-latest   cheapest, still handles Scout well
MISTRAL_MODEL=mistral-medium-latest

# Anthropic — claude-haiku-4-5   fastest + cheapest
#             claude-sonnet-4-5  stronger reasoning, costs more
ANTHROPIC_MODEL=claude-haiku-4-5

# OPENAI_MODEL=gpt-4o-mini
# GROQ_MODEL=llama-3.3-70b-versatile
# OPENROUTER_MODEL=openrouter/auto

# ─── 3b. REASONING EFFORT (reasoning-capable models only) ────
# Makes the model think before answering. Mistral Small 4
# (mistral-small-2603) and the magistral family support it:
#
#   none | minimal | low | medium | high | xhigh | max
#
# Higher effort = better judgement, MORE TOKENS BILLED, slower replies.
# The thinking itself is discarded server-side and never shown to a
# teen, but you still pay for those tokens.
#
# Leave unset to send no parameter at all — required for models that
# are not reasoning-capable, which reject it outright.
# MISTRAL_REASONING_EFFORT=high

# Check support before enabling: `npm run check` lists your models, and
# the models endpoint reports "reasoning":true for the ones that allow it.

# ⚠️ There is ALSO a generic LLM_MODEL. It applies to whichever provider
# is active and BEATS the per-provider lines above, so a leftover value
# gets sent to the wrong service — e.g. LLM_MODEL=mistral-small-latest
# with LLM_PROVIDER=anthropic sends a Mistral name to Anthropic and
# fails. Prefer the per-provider lines; the app warns on boot if
# LLM_MODEL is shadowing one. Only useful with LLM_PROVIDER=custom.
# LLM_MODEL=


# ─── 4. SECURITY ─────────────────────────────────────────────

# ⚠️ SET THIS IF nginx / Caddy / Cloudflare / a hosting panel sits in
# front of the app. Without it every visitor looks like the proxy, so
# they all share ONE rate-limit bucket and one visitor can lock out the
# whole site. Only enable it when a proxy really is in front —
# otherwise a client can spoof X-Forwarded-For and dodge the limits.
# TRUST_PROXY=true

# Per-IP ceilings on /api/chat. Every call costs real money, so these
# are what stops someone draining the API key. Defaults shown.
# RATE_LIMIT_PER_MINUTE=12
# RATE_LIMIT_PER_DAY=200

# ── Come-back-later codes ──────────────────────────────────────────
# A teen finishes on one device and picks up on another using three
# words ("sun-dance-flower"), scanned from a QR or typed in.
#
# ⚠️ RATE_LIMIT_CODE_LOOKUPS IS A SECURITY CONTROL, NOT A TUNING KNOB.
# A code is short enough to say out loud, which means it is short
# enough for a script to guess. This limit is the only thing making
# that impractical. Raising it hands out other teens' conversations.
# RATE_LIMIT_CODE_LOOKUPS=20
#
# How long a saved conversation lives before it is deleted. The purge
# runs at boot and hourly.
# SESSION_RETENTION_DAYS=90
#
# Where the SQLite file lives. Defaults to ./data/sessions.db, which
# MUST be a mounted volume in Docker — otherwise a rebuild throws away
# every code ever issued. See docker-compose.yml.
# SESSION_DB_FILE=/app/data/sessions.db

# Conversation size caps (cost control — a huge history is an expensive
# request). Defaults shown.
# LLM_MAX_MESSAGES=120
# LLM_MAX_CHARS=60000

# /api/llm/status and /api/llm/models expose server paths and a key
# fingerprint, so they are loopback-only unless you set a token. With
# one set, call them as: Authorization: Bearer <token>
# Generate:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# LLM_ADMIN_TOKEN=

# control-server.js (the panel at control.hustleclub.app — deliberately
# not named "admin" anywhere in the URL) is reachable directly from the
# internet with no proxy auth in front of it, so this is required — the
# server refuses to start without it, there is no fallback password.
# Same value unlocks both the HTTP Basic Auth prompt and control.html's
# own login form.
# Generate:  node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
# ADMIN_PASSWORD=


# ─── 5. USAGE LOG ────────────────────────────────────────────
# Plain-text record of when the app is used, from which region, and at
# what date and time. No conversation content is ever written.
#   tail -f logs/usage.log

# Where to write it. Default: ./logs/usage.log
# USAGE_LOG_FILE=/var/log/hustleclub/usage.log

# Turn it off entirely.
# USAGE_LOG=off

# Visitor IPs are HASHED by default — you still get a stable visitor id
# for counting and abuse-spotting, without storing a minor's IP.
# Set to "full" only with a policy that covers it.
# USAGE_LOG_IP=full

# Hash salt. Random per restart by default, so visitor ids are not
# comparable across restarts. Set a fixed secret to make them stable
# over time — that enables long-term tracking, so choose deliberately.
# USAGE_LOG_SALT=

# Rotate to usage.log.1 past this size. Default 10 MB.
# USAGE_LOG_MAX_BYTES=10485760


# ─── 6. OPTIONAL ─────────────────────────────────────────────

# Port the server listens on / the container publishes.
PORT=3000

# Any OpenAI-compatible endpoint that isn't listed above. Set
# LLM_PROVIDER=custom and point this at its /v1 base. Also works as an
# override for a known provider (regional endpoint, corporate gateway).
# LLM_BASE_URL=https://api.example.com/v1

# Give up on a slow provider after this many ms.
# LLM_TIMEOUT_MS=60000

# Some newer OpenAI models renamed max_tokens. If you see an error
# naming that field, set this to max_completion_tokens.
# LLM_MAX_TOKENS_FIELD=max_tokens
